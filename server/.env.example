# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# The Supabase database: Project Settings > Database > Connection string. Use
# the "Session pooler" one (it works over IPv4) and put your database password
# in it. A local Postgres works too, for development:
#   postgresql://postgres:devpassword@localhost:5432/portfolio
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase, for checking who is signed in and for the file bucket.
# Project Settings > API. The service role key can do ANYTHING in the project,
# skipping every access rule: it belongs only here, never in the client, never
# in git, never in a screenshot. If it leaks, reset it in the same page.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The public Storage bucket that holds uploaded images and .glb models.
SUPABASE_BUCKET=media

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
# Add the deployed site's too, like https://yourname.github.io
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
